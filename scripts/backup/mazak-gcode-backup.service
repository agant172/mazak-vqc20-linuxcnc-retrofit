[Unit]
Description=Mirror the LinuxCNC working directory (G-code, tool tables, configs) to the media SSD
Documentation=file:/home/andy/mazak-vqc20-linuxcnc-retrofit/scripts/backup/README.md
# The mount is the whole point of the job, so do not even try before it exists.
# The script re-checks with mountpoint(1) anyway — RequiresMountsFor only orders
# the start, it cannot promise the disk is still there when rsync runs.
RequiresMountsFor=/mnt/media

[Service]
Type=oneshot
User=andy
Group=andy
Environment=HOME=/home/andy
Environment=SRC=/home/andy/linuxcnc
Environment=DEST_MOUNT=/mnt/media
Environment=DEST_ROOT=/mnt/media/linuxcnc-backup
# Runs the INSTALLED COPY, not the script in the working copy: mazak-repo-pull
# rewrites that working copy on its own timer, and bash reads a script
# incrementally, so a pull landing mid-run could resume at a stale byte offset.
# install_gcode_backup.sh keeps the copy in sync — edit the repo version and
# re-run the installer.
ExecStart=/usr/local/bin/mazak-gcode-backup.sh
TimeoutStartSec=600
# This box runs realtime motion threads. Give the copy the lowest priority the
# scheduler offers and idle disk I/O, so a backup can never contend with a
# running program.
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
