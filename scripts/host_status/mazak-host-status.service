[Unit]
Description=Mazak VQC 20/40 LinuxCNC host status reporter (one-shot)
Documentation=https://github.com/agant172/mazak-vqc20-linuxcnc-retrofit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=andy
Group=andy
# Adjust MAZAK_REPO_DIR if the working copy lives elsewhere on the LinuxCNC host.
Environment=MAZAK_REPO_DIR=/home/andy/mazak-vqc20-linuxcnc-retrofit
Environment=MAZAK_MESA_IP=192.168.1.121
Environment=MAZAK_STATUS_BRANCH=main
ExecStart=/bin/bash /home/andy/mazak-vqc20-linuxcnc-retrofit/scripts/host_status/collect_status.sh
# Never let a stuck git push hang the timer indefinitely.
TimeoutStartSec=120
# Read-only toward LinuxCNC; keep it out of RT scheduling.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
