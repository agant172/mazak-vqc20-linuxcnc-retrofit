(  ==================================================================== )
(  Mazak VQC 20/40 retrofit - remapped M6 tool change                    )
(  linuxcnc/remap/toolchange.ngc                                             )
(                                                                        )
(  AUTHORITATIVE SOURCE: docs/ladder/atc_ladder_transcription.md         )
(    cycle entry sheet 65, cycles D/E/F sheets 71-73, NC-side reference  )
(    point commands sheet 75.                                           )
(                                                                        )
(  SKELETON - NOT COMMISSIONED. Every coordinate is a placeholder read   )
(  from the [ATC] INI section; the real ZP1 / ZP2 reference points must  )
(  be recovered from the M-2 parameters or measured on the machine       )
(  (ATC doc "Open questions" #2). Do not run this with a tool fitted,    )
(  with hydraulics live, or outside a dry run until every reference      )
(  point and every confirm polarity has been verified.                   )
(  ==================================================================== )
(                                                                        )
(  DIVISION OF LABOUR - matches the OEM design.                          )
(  The Mazatrol PLC never moved an axis: it raised reference-point       )
(  commands (ZP1.B.N / ZP2.B.N) and confirmed mechanical results. Here:  )
(    this file            = the MEM-n step chain and all axis motion     )
(    linuxcnc/components/*.comp = the CND-n confirmations, interlocks, alarms )
(                                                                        )
(  ==================================================================== )
(  DIGITAL PIN MAP  (M62-M66 / M68)                                      )
(  ==================================================================== )
(  Requires num_dio >= 16 on the motmod loadrt line - see               )
(  linuxcnc/atc_orient.ini.snippet. Nets are made in linuxcnc/atc_orient.hal.      )
(                                                                        )
(  OUTPUTS  M64 P<n> = on, M65 P<n> = off (immediate),                   )
(           M62/M63 P<n> = synchronised with motion                     )
(    P0  atc-cycle-active     -> mazak-atc.cycle-start      (TCME)       )
(    P1  atc-cover-close-req  -> mazak-atc.cover-close-request (MGC.M)   )
(    P2  atc-unclamp-req      -> mazak-atc.unclamp-request   (TUCME)     )
(    P3  atc-index-req        -> mazak-atc.index-request     (TSME)      )
(    P4  atc-detect-check     -> mazak-atc.tool-detect-check (AL75/76)   )
(    P5  atc-cycle-finish     -> mazak-atc.cycle-finish      (AFINPLS)   )
(    P6  orient-req           -> mazak-orient.orient-request (SOME2)     )
(    P7  orient-cancel        -> mazak-orient.orient-cancel  (UOME2)     )
(    P8  atc-abort-request    -> mazak-atc.cycle-abort                     )
(                                                                        )
(  INPUTS   M66 P<n> L3 Q<sec> waits for HIGH, result in #5399           )
(           (#5399 = 1 satisfied, -1 timed out)                          )
(    P0  atc-step1-permit     <- mazak-atc.step1-permit   (D-1/E-1/F-1)  )
(    P1  atc-unclamp-conf     <- mazak-atc.unclamp-confirmed  (M69)      )
(    P2  atc-clamp-conf       <- mazak-atc.clamp-confirmed    (M64)      )
(    P3  atc-index-done       <- mazak-atc.index-done         (MSTP)     )
(    P4  atc-cover-open-ok    <- mazak-atc.cover-open-verified (MGCOX)   )
(    P5  spindle-oriented-lat <- mazak-orient.oriented-latch   (SOSA)    )
(    P6  atc-fault-any        <- OR of both components' fault-any        )
(    P7  atc-cover-closed-ok  <- mazak-atc.cover-closed-verified         )
(                                                                        )
(  The target pocket is NOT passed through a digital pin: it is netted   )
(  straight from iocontrol.0.tool-prep-pocket to mazak-atc.target-pot.   )
(  If a future step needs an arbitrary numeric handoff, use              )
(  M68 E0 Q<value> -> motion.analog-out-00 -> conv_float_s32.            )
(  ==================================================================== )

o<toolchange> sub

  (  ------------------------------------------------------------------ )
  (  Modal state and cycle decision                                      )
  (  ------------------------------------------------------------------ )
  M70                        ( save modal state, restored by M72 below  )
  G90 G94 G20                ( absolute, units/min, INCH - the [ATC]     )
                             ( values are inches; without G20 a metric   )
                             ( caller would move to Z-5.9055 MM and      )
                             ( unclamp over the table. M72 restores the  )
                             ( caller's units.                           )

  #<spindle_tool>  = #5400              ( D1 - tool currently in spindle )
  #<want_tool>     = #<_selected_tool>  ( D2 - tool commanded by T       )

  #<t_orient>  = #<_ini[ATC]ORIENT_TIMEOUT>
  #<t_confirm> = #<_ini[ATC]CONFIRM_TIMEOUT>
  #<t_index>   = #<_ini[ATC]INDEX_TIMEOUT>

  ( Reference points - RESEQUENCED 2026-09-04 (owner approved). Naming   )
  ( now matches the ladder: ref-1/ZP1 = machine zero (0,0,0); ref-2/ZP2  )
  ( = the ATC exchange position (Y +9.5000, Z -5.9055). Both INI copies  )
  ( were flipped in the same commit - REF1_Z is now 0.0 and REF2_Z is    )
  ( -5.9055. Readable aliases below; LZ4 exchange floor -5.9449 is never )
  ( commanded.                                                           )
  #<z_clear>   = #<_ini[ATC]REF1_Z>   ( ZP1: Z machine zero, spindle up  )
  #<z_exch>    = #<_ini[ATC]REF2_Z>   ( ZP2: exchange height -5.9055     )
  #<y_home>    = #<_ini[ATC]REF1_Y>   ( ZP1: Y machine zero              )
  #<y_pot>     = #<_ini[ATC]REF2_Y>   ( ZP2: Y +9.5000, flange in fork   )

  ( Rung 6511 EQTST - commanded tool already in the spindle: skip.       )
  o<tc_skip> if [#<want_tool> EQ #<spindle_tool>]
    (debug, ATC: T#<want_tool> already in spindle - EQTST, cycle skipped)
    M72
    o<toolchange> return [1]
  o<tc_skip> endif

  ( Rungs 6509/6510 - cycle selection. The component computes the same   )
  ( thing from iocontrol and publishes it on mazak-atc.cycle-select;     )
  ( this copy exists so the NGC can branch without reading HAL.          )
  (   1 = full change   (D)  spindle has a tool, a new one is commanded  )
  (   2 = load only     (ladder cycle F)  spindle empty                  )
  (   3 = return only   (ladder cycle E)  T0 commanded                   )
  #<cycle> = 1
  o<tc_sel1> if [#<spindle_tool> EQ 0]
    #<cycle> = 2
  o<tc_sel1> endif
  o<tc_sel2> if [#<want_tool> EQ 0]
    #<cycle> = 3
  o<tc_sel2> endif

  (  ------------------------------------------------------------------ )
  (  Dry-run guard - authority is the HAL bit atc-live-permit, NOT INI.  )
  (                                                                      )
  (  Previously this remap printed a debug string on DRY_RUN and then    )
  (  ran every M64 output and every G53 motion anyway; that made "dry"   )
  (  runs indistinguishable from live cycles on a machine with hydraulics)
  (  and drives energised. Now dry-run aborts the whole sub before ANY   )
  (  output is asserted or ANY axis command issues. The interpreter is   )
  (  still told the requested tool is in the spindle so program flow     )
  (  continues; that M61 spoof is now HARMLESS because the same          )
  (  atc-live-permit bit that selects dry-run also holds the spindle     )
  (  motion permit FALSE - no FR-SX path can cut while dry-run is set.   )
  (                                                                      )
  (  DRY-RUN AUTHORITY LIVES IN HAL, not the INI. This reads the HAL bit )
  (  atc-live-permit via motion.digital-in-15 (M66 P15): #5399 = 0 means )
  (  dry-run. It is the SAME signal that inhibits the spindle in         )
  (  mazak_vqc_20_40.hal, so the interpreter and the physical interlock  )
  (  cannot disagree. To exercise the sequence for real, set             )
  (  atc-live-permit = 1 in HAL (reviewed edit) and restart LinuxCNC.    )
  (  Do NOT edit this file to work around the interlock.                 )
  (  ------------------------------------------------------------------ )
  M66 P15 L0                 ( read atc-live-permit; #5399 = 0 means dry-run )
  o<tc_dryrun> if [#5399 EQ 0]
    ( spindle-live MAINTENANCE (spindle-maint-permit on motion.digital-in-14):  )
    ( the spindle is permitted while the ATC is held idle. A tool change here is )
    ( unsafe - the spindle may be cutting - so ABORT rather than spoof the tool. )
    M66 P14 L0               ( read spindle-maint-permit; #5399 = 1 in maint )
    o<tc_maint> if [#5399 GT 0]
      (abort, ATC: tool change requested in spindle maintenance mode - the ATC is held idle while the spindle is live. Clear spindle-maint-permit and set atc-live-permit before changing tools.)
    o<tc_maint> endif
    (debug, ATC DRY_RUN active: T#<want_tool> cycle=#<cycle> - no outputs, no motion)
    M61 Q#<want_tool>          ( pretend the change succeeded so M6 returns )
    M72                        ( restore modal state saved by M70          )
    o<toolchange> return [1]
  o<tc_dryrun> endif

  ( Clear the latched abort request and every stale command from a previous )
  ( interrupted cycle before asserting TCME. on_abort.ngc leaves P8 high.   )
  M65 P0
  M65 P1
  M65 P2
  M65 P3
  M65 P4
  M65 P5
  M65 P6
  M65 P7
  M65 P8

  (  ------------------------------------------------------------------ )
  (  Cycle entry - sheet 65. TCME extends the barrier and holds feed.    )
  (  Feed hold during the change (ATCFHDME) is implicit: motion is       )
  (  already paused inside the remap.                                    )
  (  ------------------------------------------------------------------ )
  M64 P0                     ( TCME on - barrier out, ATC active         )

  (  ------------------------------------------------------------------ )
  (  Prep: orient the spindle, open the cover.                           )
  (  Ladder equivalent: cycles A/B/C on sheets 67-70 raise the reference )
  (  point commands and wait for the orient chain (sheet 30).            )
  (  ------------------------------------------------------------------ )
  M64 P6                     ( SOME2 - orient request                    )
  M66 P5 L3 Q#<t_orient>     ( wait for the SOSA oriented latch          )
  o<tc_or_to> if [#5399 LE 0]
    (abort, ATC: spindle failed to orient within #<t_orient> s - check AL45/AL46)
  o<tc_or_to> endif

  M65 P1                     ( cover valve de-energised = OPEN           )
  M66 P4 L3 Q#<t_confirm>    ( wait for MGCOX cover-verified-open        )
  o<tc_cov_to> if [#5399 LE 0]
    (abort, ATC: magazine cover did not verify open - check AL73/AL74)
  o<tc_cov_to> endif

  (  ------------------------------------------------------------------ )
  (  Entry positioning - RESEQUENCED 2026-09-04 to the corrected chains. )
  (  The exchange is HORIZONTAL fork-entry: Y slides the flange past the )
  (  spring detent balls into the pot fingers at exchange height; Z-up   )
  (  releases, Z-down engages; clamp always precedes the Y-out that      )
  (  breaks the detents loose.                                           )
  (  D/E (spindle holds a tool, rungs 7101/7203 entry ZPY1.ZPZ2): Z goes )
  (  DOWN to exchange height first at Y home, then Y carries the tool    )
  (  into the fork. F (spindle empty, rung 7210 entry ZPZ1.ZPY1): Y      )
  (  traverses at Z clear, Z descends onto the new tool later.           )
  (  ------------------------------------------------------------------ )
  o<tc_entry> if [#<cycle> EQ 2]
    G53 G0 Z#<z_clear>       ( F: spindle empty - travel at Z up         )
    G53 G0 Y#<y_pot>         ( F-1: Y in over the commanded pot          )
  o<tc_entry> else
    G53 G0 Z#<z_exch>        ( D/E: Z down to exchange height at Y home  )
    G53 G0 Y#<y_pot>         ( D-1/E-1: flange into the fork fingers     )
  o<tc_entry> endif

  (  ------------------------------------------------------------------ )
  (  Step 1 - D-1 / E-1 / F-1 gate (rungs 7103 / 7205 / 7302).           )
  (  Require: oriented latch, cover open, and the correct tool detect.   )
  (  The component raises AL75/AL76 and drops the permit if the detects  )
  (  disagree - nothing advances toward the exchange.                    )
  (  ------------------------------------------------------------------ )
  M64 P4                     ( arm the tool-detect comparison            )
  M66 P0 L3 Q#<t_confirm>    ( wait for step1-permit                     )
  o<tc_s1_to> if [#5399 LE 0]
    (abort, ATC: step-1 gate not satisfied - orient, cover or tool detect)
  o<tc_s1_to> endif
  M65 P4                     ( disarm immediately - 2026-09-04: leaving  )
                             ( this armed latched AL75/AL76 on every     )
                             ( cycle when later steps legitimately       )
                             ( change the detect states                  )

  (  ------------------------------------------------------------------ )
  (  Unclamp (all cycles). D/E: the fork holds the old tool. F: the      )
  (  drawbar opens EMPTY so Z can descend onto the new tool's stud.      )
  (  The output itself is gated in HAL on the oriented latch and zero    )
  (  speed; this only requests it.                                       )
  (  ------------------------------------------------------------------ )
  M64 P2                     ( TUCME - unclamp request                   )
  M66 P1 L3 Q#<t_confirm>    ( wait for M69 unclamp confirmed (TUCPRS)   )
  o<tc_unc_to> if [#5399 LE 0]
    (abort, ATC: tool unclamp not confirmed - check PRS-8 and hydraulics)
  o<tc_unc_to> endif

  (  ------------------------------------------------------------------ )
  (  Exchange - per cycle.                                               )
  (  D (full): Z up leaves the old tool in the fork -> index to the new  )
  (  pot -> Z back down onto the new tool -> clamp -> Y out (detents     )
  (  break with the tool CLAMPED) -> Z up.                               )
  (  E (return): Z up leaves the tool -> clamp EMPTY -> Y out at Z up.   )
  (  NOTE bench item 43: if TCPRS does not make on an empty clamp, the   )
  (  P2 wait here times out - verify before first live E cycle.          )
  (  F (load): Z down onto the new tool (drawbar open) -> clamp -> Y out )
  (  at exchange height -> Z up.                                         )
  (  Return-pot staging (decision-queue item 10) is NOT yet implemented: )
  (  D/E drop the old tool at whatever pot is present.                   )
  (  ------------------------------------------------------------------ )
  o<tc_full> if [#<cycle> EQ 1]
    G53 G0 Z#<z_clear>       ( D-2: old tool stays in the fork           )
    M64 P3                   ( D-3ax: index to iocontrol tool-prep-pocket)
    M66 P3 L3 Q#<t_index>    ( wait for MSTP - commanded pot arrived     )
    o<tc_idx_to> if [#5399 LE 0]
      (abort, ATC: magazine did not reach the commanded pot - check MIPRS/BCD)
    o<tc_idx_to> endif
    M65 P3
    G53 G0 Z#<z_exch>        ( D-3: down onto the new tool, drawbar open )
    M65 P2                   ( drop TUCME - clamp the new tool           )
    M66 P2 L3 Q#<t_confirm>  ( wait for M64 clamp confirmed (TCPRS)      )
    o<tc_clpd_to> if [#5399 LE 0]
      (abort, ATC: tool clamp not confirmed - check PRS-9 and hydraulics)
    o<tc_clpd_to> endif
    G53 G0 Y#<y_home>        ( D-4: Y out - clamped tool breaks detents  )
    G53 G0 Z#<z_clear>       ( D-5: rise; OEM INTF2 check not yet impl.  )
  o<tc_full> endif

  o<tc_ret> if [#<cycle> EQ 3]
    G53 G0 Z#<z_clear>       ( E-2: tool stays in the fork, spindle up   )
    M65 P2                   ( drop TUCME - clamp EMPTY (bench item 43)  )
    M66 P2 L3 Q#<t_confirm>  ( wait for clamp confirmed                  )
    o<tc_clpe_to> if [#5399 LE 0]
      (abort, ATC: empty clamp not confirmed - see bench item 43 TCPRS-empty)
    o<tc_clpe_to> endif
    G53 G0 Y#<y_home>        ( E-3: Y out at Z clear - nothing hanging   )
  o<tc_ret> endif

  o<tc_load> if [#<cycle> EQ 2]
    G53 G0 Z#<z_exch>        ( F-2: down onto the new tool, drawbar open )
    M65 P2                   ( drop TUCME - clamp the new tool           )
    M66 P2 L3 Q#<t_confirm>  ( wait for clamp confirmed                  )
    o<tc_clpf_to> if [#5399 LE 0]
      (abort, ATC: tool clamp not confirmed - check PRS-9 and hydraulics)
    o<tc_clpf_to> endif
    G53 G0 Y#<y_home>        ( F-3: Y out - clamped tool breaks detents  )
    G53 G0 Z#<z_clear>       ( F-4: rise; OEM INTF2 check not yet impl.  )
  o<tc_load> endif

  (  ------------------------------------------------------------------ )
  (  Close the cover, finish. The OEM interference check (INTF2.N /      )
  (  EIA.N, ATC doc open question #3) is still replaced by the plain     )
  (  clearance rises above; tool-length-aware Z clearance remains to be  )
  (  added once the tool table is populated.                             )
  (  ------------------------------------------------------------------ )
  M64 P1                     ( energise the cover valve = CLOSE          )
  M66 P7 L3 Q#<t_confirm>
  o<tc_cvc_to> if [#5399 LE 0]
    (abort, ATC: magazine cover did not verify closed - check AL71/AL72)
  o<tc_cvc_to> endif

  ( AFINPLS (rung 3007): finish pulse clears TCME, retracts the barrier  )
  ( and - via UOME2 - releases the orient command so the spindle is free )
  ( for the next S word.                                                 )
  M64 P5
  M65 P6                     ( drop the orient request                   )
  M64 P7                     ( UOME2 - unorient                          )
  G4 P0.1
  M65 P7
  ( P0 cleared BEFORE P5 (2026-09-04, decision-queue item 9a): mazak_atc.comp's )
  ( cycle_active latch checks cycle_finish before cycle_start with no trailing  )
  ( else - dropping P5 while P0 (barrier/TCME) is still high re-latches         )
  ( cycle_active/atc_barrier true with nothing left in this cycle to clear it.  )
  M65 P0                     ( TCME off                                  )
  M65 P5

  (  ------------------------------------------------------------------ )
  (  Tell the interpreter which tool is now in the spindle.              )
  (  M61 needs the machine to be stopped, which it is here.              )
  (  ------------------------------------------------------------------ )
  M61 Q#<want_tool>

  M72                        ( restore modal state saved by M70          )

o<toolchange> endsub [1]

M2
