# 7i84U remote field I/O -- two cards on 7i80HDT smart-serial (via 7i44 P1)
#
# 7i84U-A (port 0): ATC, hydraulics, coolant, air, utility, spindle digital I/O
#                   (existing 32/16 field I/O near green breakout PCB).
# 7i84U-B (port 1): X/Y/Z limits + homes, X/Y/Z drive-enables, and five
#                   relay-driven loads (air/touch/tap blast, ATC barrier, flood).
#
# Naming convention: hm2_7i80.0.7i84.0.<port>.input-NN / output-NN.
# The exact smart-serial device tag and pin names differ by firmware and
# smart-serial port; use `halcmd show pin hm2` after loading the actual
# firmware, then replace the placeholder pin names below.
#
# AUTHORITY: mesa/current_pin_authority.csv is the single source of truth for
# pin -> signal mapping on both 7i84U cards. This file, atc_orient.hal, and
# motion_7i80hdt.hal all agree with that CSV. The agreement is enforced by
# scripts/validate_authority.py -- run it before every commit that touches
# this file or the CSV. See docs/authority_hierarchy.md for the full hierarchy.
#
# TERMINAL BLOCKS: Per Mesa 7i84 manual (http://www.mesanet.com/pdf/parallel/7i84man.pdf)
# the physical terminal blocks on the 7i84 are TB1 (POWER ONLY: VFIELDA, VFIELDB,
# VIN, GND), TB3 (INPUT0-15 and OUTPUT0-7), and TB2 (INPUT16-31 and OUTPUT8-15).
# The hostmot2 pin names below are `input-NN` / `output-NN` regardless of
# physical terminal - the physical TB assignment is documented for wiring only.

#####################################################################
# 7i84U-A (7i44 port 0 = sserial channel 0) inputs 0..31
# Physical: IN0-15 on TB3 pins 1-16 ; IN16-31 on TB2 pins 1-16
#####################################################################

# --- IN0..IN9  (ATC + spindle, TB3 pins 1-10) ---
net atc-y-zone         <= hm2_7i80.0.7i84.0.0.input-00   # IN0  PRS-55 Y ATC zone
net atc-z-zone         <= hm2_7i80.0.7i84.0.0.input-01   # IN1  PRS-66 Z ATC zone
# IN2..IN7 + IN9 are netted in atc_orient.hal (mag-tool-avail, spindle-tool-avail,
# spindle-oriented, spindle-zero-speed, mag-cover-open-conf, mag-cover-closed-conf,
# manual-unclamp-pb). Do NOT re-net them here.
net thermal-alarm      <= hm2_7i80.0.7i84.0.0.input-08   # IN8  X073 THR.M + X07B ONT.M series NC

# --- IN10..IN15  (drive faults + spindle + tool clamp, TB3 pins 11-16) ---
# amp-fault-in: if TRUE, motion module immediately aborts and enters E-stop.
# CAUTION: confirm input polarity before enabling. The Mitsubishi HD81/HD101 ALM
# output is BELIEVED to be open-collector-active-low (fault = low/open), so
# consuming '-not' on these inputs would present logic 1 to joint.N.amp-fault-in
# on a fault. Do NOT use a nonexistent invert_input parameter - see the input-
# polarity note above the limit block.
# **UNVERIFIED** - no primary Mitsubishi manual for HD81/HD101 is in this repo;
# the polarity assumption comes from a PCW forum discussion, not manufacturer
# documentation. Bench-verify the actual ALM contact behavior against the amp
# BEFORE these inputs are wired into the safety chain. See
# docs/superseded_claims_2026-08-06.md #16.
net x-drive-fault      <= hm2_7i80.0.7i84.0.0.input-10   # IN10 X drive ALM
net x-drive-fault      => joint.0.amp-fault-in
net y-drive-fault      <= hm2_7i80.0.7i84.0.0.input-11   # IN11 Y drive ALM
net y-drive-fault      => joint.1.amp-fault-in
net z-drive-fault      <= hm2_7i80.0.7i84.0.0.input-12   # IN12 Z drive ALM
net z-drive-fault      => joint.2.amp-fault-in
net spindle-at-speed   <= hm2_7i80.0.7i84.0.0.input-13   # IN13 FR-SX SPD-REACH
net spindle-fault      <= hm2_7i80.0.7i84.0.0.input-14   # IN14 FR-SX ALM
net tool-clamped       <= hm2_7i80.0.7i84.0.0.input-15   # IN15 PRS-9 tool-clamp confirm

# --- IN16..IN23  (tool unclamp confirm + gear + BCD, TB2 pins 1-8) ---
net tool-unclamped     <= hm2_7i80.0.7i84.0.0.input-16   # IN16 PRS-8 tool-unclamp confirm
# IN17-IN23 netted in atc_orient.hal (gear-hi-conf/gear-lo-conf/mag-bcd-bit0..4).

# --- IN24..IN27  (safety chain + utility, TB2 pins 9-12) ---
net door-interlock     <= hm2_7i80.0.7i84.0.0.input-24   # IN24 LS-140+LS-141+X01D ITMDSS series NC
net lube-ok            <= hm2_7i80.0.7i84.0.0.input-25   # IN25 X042 HLP2 + X079 HLP series NC
net coolant-low        <= hm2_7i80.0.7i84.0.0.input-26   # IN26 coolant level (polarity TBD)
# IN27 hydraulic-ok netted in atc_orient.hal.

# --- IN28..IN31  (magazine + panel + estop monitor, TB2 pins 13-16) ---
# IN28 mag-in-pos: writer declared here (physical-pin authority lives in this
# file, per docs/authority_hierarchy.md). atc_orient.hal only reads mag-in-pos
# and must not attempt to source it.
# CSV status: MAG_IN_POS = PROPOSED (mesa/current_pin_authority.csv). The prox
# is required for magazine indexing per the OEM ladder (rungs 3401/33xx). The
# terminal is not yet electrically verified - do not enable the ATC sequence
# until this input passes bench and field verification per
# docs/pre_power_deliverables.md D4.
net mag-in-pos         <= hm2_7i80.0.7i84.0.0.input-28   # IN28 MIPRS mag-in-pos prox (PLC X00D)
net estop-monitor      <= hm2_7i80.0.7i84.0.0.input-29   # IN29 OEM MAR aux via interposing relay
# IN30 manual-clamp-pb reserved (PROPOSED, not netted until wired):
# net manual-clamp-pb    <= hm2_7i80.0.7i84.0.0.input-30
# IN31 servo-ready netted in atc_orient.hal.

#####################################################################
# 7i84U-A (7i44 port 0) outputs 0..15
# Physical: OUT0-7 on TB3 pins 17-24 ; OUT8-15 on TB2 pins 17-24
#####################################################################

# WARNING: verify coil/load current and voltage. Use interposing relays or
# output modules where required. Add suppression appropriate to each coil.

net spindle-fwd        <= spindle.0.forward
net spindle-fwd        => hm2_7i80.0.7i84.0.0.output-00  # OUT0  FR-SX FWD
net spindle-rev        <= spindle.0.reverse
net spindle-rev        => hm2_7i80.0.7i84.0.0.output-01  # OUT1  FR-SX REV
# HOLD (audit 2026-08-07): spindle drive polarity is UNVERIFIED. The three
# spindle output nets below (spindle-fwd on OUT0, spindle-rev on OUT1,
# spindle-enable on OUT2 = FR-SX RUN/STOP) remain nominally connected to
# their sources, but pwmgen.03.enable is force-false in motion_7i80hdt.hal:
# so AOUT3 sits at 0 V and the drive will not respond even if these
# discrete outputs momentarily float TRUE. See motion_7i80hdt.hal 'HOLD
# POINT - SPINDLE DRIVE POLARITY UNVERIFIED' for the full clearance path.
# spindle-enable is sourced in mazak_vqc_20_40.hal from spindle.0.on. Under
# normal (non-HOLD) operation it would follow the same M3/M4 timing as
# pwmgen.03.enable; while the HOLD is asserted, the FR-SX still sees
# spindle-enable transition on M3/M4 but AOUT3 stays at 0 V because
# pwmgen.03.enable is force-false in motion_7i80hdt.hal, so no rotation occurs.
net spindle-enable     => hm2_7i80.0.7i84.0.0.output-02  # OUT2  FR-SX RUN/STOP
# OUT3  hyd-pump-on         (netted in atc_orient.hal - Y096 HYD.M)
# OUT4  spindle-orient-cmd  (netted in atc_orient.hal - Y093 ORCM1.M)
# OUT5  orient-lo-gear      (netted in atc_orient.hal - Y094 CTL.M)
# OUT6 Z brake release: asymmetric sequencer, on-delay on rising edge only.
# See detailed rationale and wiring in the 7i84U-B S-ON section below
# (both the Z S-ON via timedelay.1 and the Z brake release via timedelay.0
# are driven from the same z-enable-req signal defined there).
setp timedelay.0.on-delay  0.100    # T_torque_build: PLACEHOLDER, measure per D7
setp timedelay.0.off-delay 0.000    # brake drops the instant z-enable-req falls
net z-brake-release    <= timedelay.0.out
net z-brake-release    => hm2_7i80.0.7i84.0.0.output-06  # OUT6  N1J-L2-201 Z brake release
# OUT7  gear-hi-sol        (netted in atc_orient.hal - Y00B GSH.M / RLY-1 to SOL-13)
# OUT8  gear-lo-sol        (HOLD_CONFLICT in authority CSV; unbound in atc_orient.hal)
# OUT9  tool-clamp-sol     (netted in atc_orient.hal - dual-coil clamp reserved)
# OUT10 tool-unclamp-sol   (netted below - single writer)
net tool-unclamp-sol   => hm2_7i80.0.7i84.0.0.output-10  # OUT10 RLY-4 to SOL-10
net flood-coolant      <= iocontrol.0.coolant-flood
net flood-coolant      => hm2_7i80.0.7i84.0.0.output-11  # OUT11 flood pump relay
# HOLD_CONFLICT: OUT12 physical load identity unverified.
# See wiring/authority_conflicts.md and mesa/current_pin_authority.csv MIST_COOLANT row.
# Do NOT restore this binding until the physical load is traced at the cabinet.
# net mist-coolant       <= iocontrol.0.coolant-mist
# net mist-coolant       => hm2_7i80.0.7i84.0.0.output-12  # OUT12 (was lube-on; verify)

# HOLD_CONFLICT: OUT13/OUT14 magazine rotation direction unproven.
# See wiring/authority_conflicts.md #3 and mesa/current_pin_authority.csv MAG_CW_SOL / MAG_CCW_SOL rows.
# atc_orient.hal creates the mag-cw-sol / mag-ccw-sol nets from mazak-atc; keeping them
# off the physical relays until SOL-8A/SOL-8B mapping is verified under controlled commissioning.
# net mag-cw-sol         => hm2_7i80.0.7i84.0.0.output-13  # OUT13 ATC motor fwd relay
# net mag-ccw-sol        => hm2_7i80.0.7i84.0.0.output-14  # OUT14 ATC motor rev relay
# OUT15 alarm-out: optional stack light / horn
# net alarm-out          => hm2_7i80.0.7i84.0.0.output-15

#####################################################################
# IOCONTROL loopbacks (active immediately; replace when ATC logic is ready)
#####################################################################
#
# Auto-complete tool-prepare: LinuxCNC marks the pocket prepared without waiting
# for a physical acknowledgement. mazak-atc reads iocontrol.0.tool-prep-pocket
# directly, so this loopback stays in place even after the M6 remap goes live.
net tool-prepare-loopback  iocontrol.0.tool-prepare => iocontrol.0.tool-prepared

# tool-change loopback DELETED. The M6 remap in linuxcnc/remap/toolchange.ngc
# now drives iocontrol.0.tool-changed via its M64 P5 (atc-cycle-finish) rung
# through the mazak-atc component (see atc_orient.hal). A loopback here would
# short-circuit the ATC sequence.

#####################################################################
# 7i84U-B (7i44 port 0 sserial CHANNEL 1) inputs 0..31 - limits and homes
# NOTE: hostmot2 addresses this as port 0 channel 1 -> hm2_7i80.0.7i84.0.1.*
# Physical: IN0-15 on TB3 pins 1-16 ; IN16-31 on TB2 pins 1-16
#####################################################################
#
# X/Y/Z overtravel limits (IN0-IN5) are NC contacts -- open (tripped) reads
# as logic 1 by consuming the '-not' complementary input pin.
# X/Y/Z home switches (IN6-IN8) are NO contacts on this machine.
#
# Input polarity note: per sserial(9), sserial remote cards (7i64/7i76/7i77/
# 7i70/7i73 - the 7i84U follows the same family pattern) expose EACH digital
# input twice: 'input-NN' (raw) and 'input-NN-not' (complement). There is NO
# 'invert_input' parameter documented for sserial input pins. Earlier revisions
# of this file called `setp hm2_...input-NN.invert_input 1` on the NC limits;
# HAL rejects that at load time because no such parameter exists on the pin.
# Correct pattern for an NC input that must read logic 1 when tripped:
#     net limit-x-plus <= hm2_7i80.0.7i84.0.1.input-00-not
# Reference: <https://linuxcnc.org/docs/html/man/man9/sserial.9.html>
#
# Why 7i84U (sserial) and not P3 direct GPIO: bare P3 GPIO is 3.3 V LVCMOS
# without opto-isolation - direct connection to 24 V field wiring would destroy
# the FPGA. The 7i84U provides opto-isolated 24 V-tolerant inputs. Timing
# characteristics of the sserial link are discussed in `docs/smart_serial_latency.md`.

net limit-x-plus  <= hm2_7i80.0.7i84.0.1.input-00-not   # X_LIMIT_PLUS  (NC contact)
net limit-x-plus  => joint.0.pos-lim-sw-in
net limit-x-minus <= hm2_7i80.0.7i84.0.1.input-01-not   # X_LIMIT_MINUS (NC contact)
net limit-x-minus => joint.0.neg-lim-sw-in
net limit-y-plus  <= hm2_7i80.0.7i84.0.1.input-02-not   # Y_LIMIT_PLUS  (NC contact)
net limit-y-plus  => joint.1.pos-lim-sw-in
net limit-y-minus <= hm2_7i80.0.7i84.0.1.input-03-not   # Y_LIMIT_MINUS (NC contact)
net limit-y-minus => joint.1.neg-lim-sw-in
net limit-z-plus  <= hm2_7i80.0.7i84.0.1.input-04-not   # Z_LIMIT_PLUS  (NC contact)
net limit-z-plus  => joint.2.pos-lim-sw-in
net limit-z-minus <= hm2_7i80.0.7i84.0.1.input-05-not   # Z_LIMIT_MINUS (NC contact)
net limit-z-minus => joint.2.neg-lim-sw-in

net home-x <= hm2_7i80.0.7i84.0.1.input-06        # LS-42 assumed
net home-x => joint.0.home-sw-in
net home-y <= hm2_7i80.0.7i84.0.1.input-07        # LS-52 assumed
net home-y => joint.1.home-sw-in
net home-z <= hm2_7i80.0.7i84.0.1.input-08        # LS-62 confirmed TB-51
net home-z => joint.2.home-sw-in

# Renishaw MP-3 probe SKIP1 on 7i84U-B input-15 (physically TB3 pin 16).
# Rationale: the 7i84U provides opto-isolated 24 V-tolerant field inputs, which
# the bare 7i80HDT P3 GPIOs do not (P3 = unbuffered 3.3 V LVCMOS -- 24 V would
# destroy the FPGA input). Latency (worst case): approximately one servo
# period, dominated by the wait for the next hm2_eth.read invocation. The
# 2.5 Mbaud SSLBP link itself adds only ~100 us DOIT round trip per Mesa's
# 7i44 manual - it does NOT set a '1 ms per bit rate' figure. See
# docs/smart_serial_latency.md for the derivation from primary sources:
# 7i44 DOIT bound and hostmot2(9) sample rhythm. The hostmot2(9) man page
# <https://linuxcnc.org/docs/html/man/man9/hostmot2.9.html> does not
# document sserial as DPLL-synchronous with the servo thread.
# This one-servo-period jitter is acceptable for tool setting and workpiece
# probing at moderate feedrates. If tighter probing accuracy is ever
# required, use a Mesa daughter card designed for opto-isolated fast inputs
# rather than bare P3 GPIO.
# Probe interface (Renishaw MI 12 or similar) idles NC -> probe trigger = low,
# so consume the '-not' complement pin to make motion.probe-input TRUE on
# contact. (sserial input pins have no invert_input parameter - see the note
# above the limit inputs.)
net probe-in <= hm2_7i80.0.7i84.0.1.input-15-not
net probe-in => motion.probe-input

# IN9..IN14 and IN16..IN31: 22 spare inputs on 7i84U-B

#####################################################################
# 7i84U-B (7i44 port 0 sserial CHANNEL 1) outputs 0..15 - drive-enables + relay loads
# Physical: OUT0-7 on TB3 pins 17-24 ; OUT8-15 on TB2 pins 17-24
#####################################################################
#
# WARNING: verify coil voltage/current and interpose relays for all 100 VAC
# solenoid loads (SOL-35/61/62). Add suppression appropriate to each coil.
# X/Y/Z drive-enable outputs go into MELDAS DK-427 ENA inputs via interposing
# relay (dry-contact input on the drive side).
#
# Drive-enable writers: joint.N.amp-enable-out is the LinuxCNC motion module's
# per-joint amplifier request. When machine is on and no fault is latched,
# amp-enable-out goes TRUE; on fault or estop it drops FALSE.
#
# WATCHDOG-INHIBIT: the raw amp-enable-out signal is gated through and2
# components against 'motion-permit' (nominally TRUE; goes FALSE when the
# hm2_eth watchdog trips or the packet-error-exceeded threshold is hit).
# See the 'Safety watchdog' block in mazak_vqc_20_40.hal for the fault-source
# wiring. Belt-and-suspenders: the same fault also trips estop-latch.0.fault-in,
# so a NIC/watchdog fault has two independent paths to disable drives:
#   (a) motion-permit=FALSE opens the and2 gates below -> x/y/z-enable=FALSE
#       -> S-ON outputs drop and pwmgen enables drop
#   (b) estop-latch.0.fault-in=TRUE -> estop-latch.0.ok-out=FALSE ->
#       iocontrol.0.emc-enable-in=FALSE -> LinuxCNC drops amp-enable-out anyway

net x-enable-raw <= joint.0.amp-enable-out
net x-enable-raw => and2.0.in0
net motion-permit => and2.0.in1
net x-enable     <= and2.0.out
net x-enable     => hm2_7i80.0.7i84.0.1.output-00   # X servo S-ON to MELDAS DK-427

net y-enable-raw <= joint.1.amp-enable-out
net y-enable-raw => and2.1.in0
net motion-permit => and2.1.in1
net y-enable     <= and2.1.out
net y-enable     => hm2_7i80.0.7i84.0.1.output-01   # Y servo S-ON to MELDAS DK-427

# Z axis - ASYMMETRIC brake/S-ON sequencer.
#
# WHY this is different from X/Y: the Z axis has a gravity load (spindle head)
# and a mechanical brake (SOL-201) that must be sequenced against the drive
# S-ON to prevent head-drop. Two edges have OPPOSITE requirements:
#
#   Rising edge (enable):
#     - S-ON must assert FIRST so the DK-427 develops holding torque.
#     - Brake release must LAG S-ON by T_torque_build (~100 ms placeholder).
#     - Achieved by: z-enable-req -> output-02 IMMEDIATELY (via timedelay.1
#       whose on-delay=0); z-enable-req -> timedelay.0.in whose on-delay
#       holds z-brake-release=FALSE for T_torque_build.
#
#   Falling edge (disable / fault / E-stop from software):
#     - Brake must ENGAGE FIRST so the mechanical hold catches the head.
#     - S-ON drop must LAG the brake-drop by T_brake_engage (~100 ms
#       placeholder). During that window the drive is still commanded ON
#       and the brake is CLOSED - torque and brake overlap by design.
#     - Achieved by: z-enable-req -> timedelay.0.in whose off-delay=0
#       (brake drops immediately); z-enable-req -> timedelay.1.in whose
#       off-delay=T_brake_engage keeps output-02 (S-ON) TRUE while the
#       brake bites.
#
# The earlier symmetric implementation (single timedelay with equal on-delay
# and off-delay driving only the brake path) was BACKWARDS on the falling
# edge - it dropped S-ON immediately and held the brake OPEN for another
# 100 ms, opening the exact head-drop window it was supposed to prevent.
# Reference: timedelay(9) 'off-delay = time the output stays TRUE after
# the input goes FALSE': <https://linuxcnc.org/docs/html/man/man9/timedelay.9.html>
#
# LIMITATIONS (open loop):
#   - Both T_torque_build and T_brake_engage are PLACEHOLDERS. Real values
#     depend on the DK-427 torque-build time (rising) and the SOL-201 brake
#     mechanical engagement time (falling). See docs/pre_power_deliverables.md
#     D7 - both must be measured separately.
#   - This sequencer only protects software-driven transitions. A hardwired
#     E-stop that yanks the amp AC contactor independent of HAL bypasses
#     timedelay.1 entirely - S-ON collapses when bus voltage collapses,
#     with no software-imposed brake-lead. That protection MUST come from
#     a cabinet-level brake-drop-before-amp-drop interlock (relay logic
#     ahead of the E-stop chain). See docs/estop_safety_chain.md.
#   - No drive-ready feedback is observed. If a SERVO_READY contact from the
#     DK-427 is later wired to a 7i84U input, AND-gate z-brake-release with
#     drive-ready via another and2 so the brake only opens once torque is
#     confirmed present, not merely elapsed.

setp timedelay.1.on-delay  0.000    # S-ON asserts immediately on request
setp timedelay.1.off-delay 0.100    # T_brake_engage: PLACEHOLDER, measure per D7

net z-enable-raw <= joint.2.amp-enable-out
net z-enable-raw => and2.2.in0
net motion-permit => and2.2.in1
net z-enable-req <= and2.2.out            # motion + watchdog permit
net z-enable-req => timedelay.0.in        # brake-release path (on-delay only)
net z-enable-req => timedelay.1.in        # S-ON path (off-delay only)
net z-enable     <= timedelay.1.out
net z-enable     => hm2_7i80.0.7i84.0.1.output-02   # Z servo S-ON to MELDAS DK-427

# 100 VAC solenoid outputs via interposing relays. Uncomment as each relay is wired.
# net air-blast          => hm2_7i80.0.7i84.0.1.output-03  # SOL-62 via RLY-5
# net touch-sensor-blast => hm2_7i80.0.7i84.0.1.output-04  # SOL-35 via RLY-6
# net tap-coolant-blast  => hm2_7i80.0.7i84.0.1.output-05  # SOL-61 via RLY-7
# OUT6 atc-barrier: netted in atc_orient.hal (PLC Y095 TCME.M)
# net flood-valve        => hm2_7i80.0.7i84.0.1.output-07  # PLC Y011 FCL

# OUT8-OUT15: 8 spare outputs on 7i84U-B
