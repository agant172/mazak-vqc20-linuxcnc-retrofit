# Mazak VQC 20/40 main HAL loader
#
# WARNING:
# This is a skeleton. The hm2_7i80.* board name, pin names, board IP, Mesa firmware,
# resolver scales, drive polarity, normal states, and all safety-chain wiring are
# UNVERIFIED PLACEHOLDERS. Confirm the exact board tag (`hm2_7i80` expected) and the
# real generated HAL names from `readhmid` / `show pin hm2` before live testing.
#
# Confirmed architecture (2026-08-13 rev; P1/P2/P3 roles flipped vs. the
# 2026-08-06 rev once the actual 7i80hdt_rmsvss6_8.bin firmware was flashed
# and read back with mesaflash --readhmid on 2026-08-11, re-confirmed
# 2026-08-13 -- see ../mesa/mesa_firmware_checklist.md):
# LinuxCNC control PC connected to a Mesa 7i80HDT Ethernet FPGA host over hm2_eth
# (static IP). Daughter cards:
#   P1: 7i49 (3 resolver channels used out of 6 + 4 of 6 +/-10V analog outs used)
#   P2: unused/spare - all bare FPGA GPIO (no daughter card fitted). Probe was
#       previously wired to a bare GPIO pin but was moved to 7i84U-B for 24V
#       opto-isolation.
#   P3: 7i44 (RS-422 sserial breakout - one sserial port with 8 channels)
#        channel 0 -> 7i84U-A (existing 32/16 field I/O near green breakout PCB:
#                     ATC, hydraulic, coolant, air, utility, spindle digital I/O,
#                     hm2_7i80.0.7i84.0.0.*)
#        channel 1 -> 7i84U-B (limits, homes, drive-enables, probe, and five
#                     relay-driven loads: air/touch/tap blast, ATC barrier,
#                     flood, hm2_7i80.0.7i84.0.1.*)
#        channels 2-7 disabled (sserial_port_0="00xxxxxx") and reserved for
#                     future compatible smart-serial devices. With a 7i44
#                     fitted, these are RS-422 channels, not general field GPIO.
# Axis position feedback is RESOLVER via the 7i49 (5 kHz excitation baseline), reading
# the machine's original Tamagawa TS2014N resolvers - not quadrature encoders.
# All field I/O -- limits/homes/E-stop monitor/drive-enables/spindle digital/
# 100 VAC solenoids -- lives on the two 7i84U cards via sserial. The 7i80HDT
# directly owns only motion-critical signals: resolvers, +/-10V velocity
# commands. The Renishaw MP-3 probe input lives on 7i84U-B TB3 IN15
# (opto-isolated 24V), NOT bare P2 GPIO; P2 remains unused/spare.

loadrt trivkins coordinates=XYZ
# num_dio=16 required by linuxcnc/atc_orient.hal + remap/toolchange.ngc, which use
# motion.digital-out-00..08 / digital-in-00..07 (motmod only creates 4 of each by default).
loadrt [EMCMOT]EMCMOT base_period_nsec=0 servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_dio=16

# The 7i80HDT is an Ethernet board loaded via hm2_eth. Set board_ip to the confirmed
# static IP and adjust num_resolvers (7i49 on P1) / sserial (7i44 on P3) for the actual
# firmware. Axis feedback is resolver via the 7i49, so the firmware/config must expose
# resolver channels (num_resolvers) rather than plain encoders. The two 7i84Us
# use physical 7i44 channels 0 and 1 inside HostMot2 smart-serial port 0; the
# single channel mask must match the loaded firmware.
# TODO: set the real board_ip and config string (incl. num_resolvers) from the 7i80HDT
# firmware / readhmid, and confirm the 7i49 pwmgen count as reported.
loadrt hostmot2
# num_pwmgens=4: the 7i49 +/-10V analog outputs ARE hostmot2 pwmgen instances (bipolar
# mode; there is no separate "analogout" object). Need >=4 for X/Y/Z + spindle;
# additional pwmgens will appear if the bitfile provisions more. Confirm the real
# count/instances against readhmid.
loadrt hm2_eth board_ip="192.168.1.121" config="num_encoders=0 num_resolvers=3 num_pwmgens=4 num_stepgens=0 sserial_port_0=00xxxxxx"
# board_ip: 192.168.1.121 (static, NIC enp0s31f6 at 192.168.1.1/24, confirmed pinging)
# num_resolvers=3: three TS2014N shaft resolvers are planned for X/Y/Z channels
#   00/01/02. Spindle feedback is not assigned to a resolver channel.
# num_encoders=0: deliberate commissioning hold. A separate machine-side
#   spindle A/B/Z source is only a hypothesis: its existence, model, electrical
#   format, and receiver hardware are unknown, and the confirmed rmsvss6_8
#   firmware has no Encoder module at all (readhmid 2026-08-13). Enable an
#   encoder instance only after that complete signal chain is documented and
#   firmware that actually provisions it is identified.
# num_pwmgens=4: 7i49 P1 AOUT0=X, AOUT1=Z, AOUT2=Y, AOUT3=spindle velocity.
#   AOUT4/AOUT5 spare. All bipolar +/-10V. FR-SX orient uses a DISCRETE
#   ORCM1 command on 7i84U-A OUT4 (Y093), NOT an analog reference — the FR-SX
#   does not accept an external analog orient reference. See
#   docs/frsx_orient_model.md and motion_7i80hdt.hal comments.
# sserial_port_0=00xxxxxx: enable channels 0 and 1 in mode 0 (00) and disable
#   channels 2..7 (xxxxxx). Per hostmot2(9), each character in the sserial_port_N
#   string configures ONE CHANNEL of a single sserial port (each port has 1-8
#   channels). Both 7i84Us live on port 0: channel 0 = 7i84U-A, channel 1 = 7i84U-B.
#   Disabling channels 2..7 with "x" may expose the underlying FPGA functions as
#   GPIO in HostMot2, but P3 is physically routed through 7i44 RS-422 transceivers;
#   do not treat those connectors as general-purpose field GPIO. sserial_port_1..3
#   are NOT declared because
#   the 7i80HDT+7i44 firmware only instantiates one sserial port on P3.
#   Ref: https://linuxcnc.org/docs/html/man/man9/hostmot2.9.html (sserial_port_N).

loadrt pid names=pid.x,pid.y,pid.z,pid.s
loadrt estop_latch count=1

# Two independent delays implement the asymmetric Z-brake sequence:
#   enable:  assert Z S-ON, then release the brake after a delay
#   disable: engage the brake, then remove Z S-ON after a delay
# A single symmetric delay is unsafe because its off-delay keeps the brake
# released after S-ON has already disappeared.
loadrt timedelay names=z-brake-delay,z-drive-drop-delay

# All or2 instances are loaded together here. A real-time module may only be
# loaded once, even though the ATC instances are scheduled in atc_orient.hal.
# Each resolver error is combined with the corresponding MELDAS drive alarm
# before reaching joint.N.amp-fault-in.
loadrt or2 names=watchdog-fault-or,atc-fault-or,atc-abort-or,atc-safety-abort-or,resolver-fault-x,resolver-fault-y,resolver-fault-z,spindle-atc-permit-or

# and2.6 combines watchdog permit with a fail-off axis commissioning hold.
# and2.0..2 gate joint amp-enable requests with that combined permit.
# and2.3..5 gate FR-SX FWD, REV, and RUN with the combined spindle permit;
# and2.7 gates the discrete ORCM1 orient command with the same permit.
loadrt and2 count=8

# Two one-input NANDs invert the watchdog and spindle-fault signals. The
# seven-input AND combines the static spindle commissioning hold, watchdog
# health, software E-stop state, spindle-drive fault state, LinuxCNC machine-on
# state, the field servo-ready input, and the ATC dry-run interlock term
# spindle-atc-ok (= atc-live-permit OR spindle-maint-permit; see the block after
# spindle-motion-permit below).
loadrt logic names=logic.watchdog-not,logic.spindle-fault-not,logic.spindle-permit-and personality=0x801,0x801,0x107
# NOTE: do NOT loadrt threads — [EMCMOT]EMCMOT above creates the servo-thread from INI SERVO_PERIOD

addf hm2_7i80.0.read           servo-thread
addf resolver-fault-x          servo-thread
addf resolver-fault-y          servo-thread
addf resolver-fault-z          servo-thread
addf watchdog-fault-or         servo-thread
addf estop-latch.0             servo-thread
addf logic.watchdog-not        servo-thread
addf logic.spindle-fault-not   servo-thread
addf spindle-atc-permit-or     servo-thread
addf logic.spindle-permit-and  servo-thread
addf motion-command-handler    servo-thread
addf motion-controller         servo-thread
addf pid.x.do-pid-calcs        servo-thread
addf pid.y.do-pid-calcs        servo-thread
addf pid.z.do-pid-calcs        servo-thread
addf pid.s.do-pid-calcs        servo-thread
addf and2.6                    servo-thread
addf and2.0                    servo-thread
addf and2.1                    servo-thread
addf and2.2                    servo-thread
addf and2.3                    servo-thread
addf and2.4                    servo-thread
addf and2.5                    servo-thread
addf and2.7                    servo-thread
addf z-brake-delay             servo-thread
addf z-drive-drop-delay        servo-thread
# hm2_7i80.0.write is deliberately scheduled at the end of atc_orient.hal,
# after every motion, safety, spindle, and ATC output-producing component.

# Axis PID gains are intentionally zero in the INI placeholders.
#
# The TRA drives close their own inner velocity loop on the motor tach
# (Tamagawa TGF-3D P402-Sx). LinuxCNC is the OUTER position loop driving those
# drives with an analog velocity reference via 7i49 pwmgen.NN.value. Commission
# the position loop with the FF1-first procedure in docs/servo_commissioning.md:
#   1. Confirm resolver direction/scale and analog output polarity.
#   2. Verify zero-command null at each 7i49 AOUT_N (|V_out| <= 50 mV).
#   3. Measure volts-per-speed with a small pid.N.bias command at low
#      MAX_OUTPUT; do not try to write the linked pid.output pin. Set
#      OUTPUT_SCALE = 10 x measured speed-per-volt so pid.output units are in/s.
#   4. Set FF1 first (typically ~1.0 once OUTPUT_SCALE is calibrated).
#   5. Add P in small steps.
#   6. Add I only for residual bias, D only if end-of-move overshoot demands it.
#
# Do NOT tune P/I/D or FF1 before step 3 is complete on that axis.
# PID doc: 'When using FF1 tuning, scaling must be set so that output is in
# user units per second.'
# PID doc direction warning: 'If some output is in the wrong direction,
# negating gains to fix it is a mistake; set the scaling correctly elsewhere
# instead.'
setp pid.x.Pgain                  [JOINT_0]P
setp pid.x.Igain                  [JOINT_0]I
setp pid.x.Dgain                  [JOINT_0]D
setp pid.x.FF0                    [JOINT_0]FF0
setp pid.x.FF1                    [JOINT_0]FF1
setp pid.x.FF2                    [JOINT_0]FF2
setp pid.x.bias                   [JOINT_0]BIAS
setp pid.x.deadband               [JOINT_0]DEADBAND
setp pid.x.maxoutput              [JOINT_0]MAX_OUTPUT
# error-previous-target: use previous target in error calc — better servo behavior
setp pid.x.error-previous-target  true
# maxerror: clamp error before PID math — prevents windup on large following errors
setp pid.x.maxerror               [JOINT_0]MAX_ERROR

setp pid.y.Pgain                  [JOINT_1]P
setp pid.y.Igain                  [JOINT_1]I
setp pid.y.Dgain                  [JOINT_1]D
setp pid.y.FF0                    [JOINT_1]FF0
setp pid.y.FF1                    [JOINT_1]FF1
setp pid.y.FF2                    [JOINT_1]FF2
setp pid.y.bias                   [JOINT_1]BIAS
setp pid.y.deadband               [JOINT_1]DEADBAND
setp pid.y.maxoutput              [JOINT_1]MAX_OUTPUT
setp pid.y.error-previous-target  true
setp pid.y.maxerror               [JOINT_1]MAX_ERROR

setp pid.z.Pgain                  [JOINT_2]P
setp pid.z.Igain                  [JOINT_2]I
setp pid.z.Dgain                  [JOINT_2]D
setp pid.z.FF0                    [JOINT_2]FF0
setp pid.z.FF1                    [JOINT_2]FF1
setp pid.z.FF2                    [JOINT_2]FF2
setp pid.z.bias                   [JOINT_2]BIAS
setp pid.z.deadband               [JOINT_2]DEADBAND
setp pid.z.maxoutput              [JOINT_2]MAX_OUTPUT
setp pid.z.error-previous-target  true
setp pid.z.maxerror               [JOINT_2]MAX_ERROR

# Spindle PID — leave unconnected until a spindle-feedback source and compatible
# receiver are identified and assigned. The possible machine-side A/B/Z path is
# not verified, num_encoders=0, and no Encoder module is present in the
# confirmed firmware. Spindle does not consume a 7i49
# resolver channel; num_resolvers=3 above allocates only X/Y/Z.
setp pid.s.Pgain                  [SPINDLE_0]P
setp pid.s.Igain                  [SPINDLE_0]I
setp pid.s.Dgain                  [SPINDLE_0]D
setp pid.s.FF0                    [SPINDLE_0]FF0
setp pid.s.FF1                    [SPINDLE_0]FF1
setp pid.s.FF2                    [SPINDLE_0]FF2
setp pid.s.bias                   [SPINDLE_0]BIAS
setp pid.s.deadband               [SPINDLE_0]DEADBAND
setp pid.s.maxoutput              [SPINDLE_0]MAX_OUTPUT
setp pid.s.error-previous-target  true
setp pid.s.maxerror               [SPINDLE_0]MAX_ERROR

#####################################################################
# Safety chain: E-stop latch + iocontrol enable
#####################################################################
#
# LinuxCNC's standard E-stop pattern using the estop-latch component
# (see estop_latch(9) man page for pin details):
#
#   estop-monitor (7i84U-A IN29)   -> estop-latch.0.ok-in
#     Physical E-stop chain aux contact: TRUE when NOT tripped. Any drop to
#     FALSE forces the latch to Faulted.
#   estop-reset                    -> estop-latch.0.reset
#     Momentary pulse that transitions the latch Faulted -> OK when ok-in and
#     fault-in permit. Sourced from iocontrol.0.user-request-enable so the
#     machine-on button clears the latch.
#   estop-latch.0.ok-out           -> iocontrol.0.emc-enable-in
#     Motion module enable. Also carried by 'estop-ok' for downstream readers
#     (atc_orient.hal, field_7i84u.hal).
#   estop-latch.0.fault-in         <- watchdog-fault-any
#     A HostMot2 watchdog bite or sustained hm2_eth packet-error condition
#     forces the software latch faulted. The hardware E-stop remains primary.
#
# CAUTION - hardware chain remains authoritative:
#   The OEM MAR relay hardware E-stop chain is the primary safety. See
#   docs/estop_safety_chain.md for the required hardwired safety schematic
#   and fault-injection matrix that must be validated before drives are
#   energized under retrofit control. Per estop_latch(9), this component is
#   'part of a simple software ESTOP chain' - not the whole chain. This latch
#   is the SOFTWARE monitor of that chain (see wiring/front_control_panel_wiring.md).
#   estop-monitor comes from a dry-contact aux on the MAR relay via an
#   interposing relay; it does NOT bypass any hardware interlock.

net estop-reset       <= iocontrol.0.user-request-enable
net estop-reset       => estop-latch.0.reset
net estop-monitor     => estop-latch.0.ok-in
net estop-ok          <= estop-latch.0.ok-out
net estop-ok          => iocontrol.0.emc-enable-in

#####################################################################
# Safety watchdog: NIC packet-error + hm2 watchdog fault routing
#####################################################################
#
# The hm2_eth driver exposes two fault-status pins that fire when the
# Ethernet link to the 7i80HDT loses integrity:
#
#   hm2_7i80.0.watchdog.has_bit         (bit out) - hostmot2 watchdog timer
#     tripped because reads/writes did not complete inside the servo period.
#     Naming convention per hostmot2(9) man page.
#     <https://linuxcnc.org/docs/html/man/man9/hostmot2.9.html>
#
#   hm2_7i80.0.packet-error-exceeded    (bit out) - hm2_eth packet-error
#     counter exceeded the configured threshold. See
#     docs/hm2_eth_nic_validation.md for the acceptance procedure that
#     configures the threshold and demonstrates the trip.
#
# Both faults must inhibit drives and stop motion. Per audit 2026-08-07,
# route them BOTH to (a) the software E-stop latch AND (b) a per-joint
# amp-enable inhibit. These are two software consumers of the same fault
# summary, not independent safety channels; the independent backstop is the
# HostMot2/7i84U hardware-watchdog safe state.
#
#     watchdog-fault-or.in0 <- hm2_7i80.0.watchdog.has_bit
#     watchdog-fault-or.in1 <- hm2_7i80.0.packet-error-exceeded
#     watchdog-fault-or.out -> watchdog-fault-any           (fault=TRUE)
#     watchdog-fault-any -> estop-latch.0.fault-in          (a)
#     NOT(watchdog-fault-any) -> watchdog-permit
#     watchdog-permit AND drive-output-permit -> motion-permit (b)
#
# Component ordering in the servo thread (see addf block above):
#   read -> resolver/drive fault ORs -> watchdog-fault-or -> estop-latch
#   -> watchdog/spindle permits -> motion-controller -> commissioning gates
#   -> joint/spindle output gates -> Z sequencing -> write
#
# NOTE: This wiring is DECLARED but the hm2 pin names below are subject
# to the NIC validation in docs/hm2_eth_nic_validation.md. Bench-verify
# each pin appears in 'halcmd show pin hm2' output before energising.

net watchdog-hm2-bit    <= hm2_7i80.0.watchdog.has_bit
net watchdog-hm2-bit    => watchdog-fault-or.in0
net watchdog-pkt-err    <= hm2_7i80.0.packet-error-exceeded
net watchdog-pkt-err    => watchdog-fault-or.in1
net watchdog-fault-any  <= watchdog-fault-or.out
net watchdog-fault-any  => estop-latch.0.fault-in

# motion-permit derivation: watchdog-fault-any must be INVERTED to become
# the motion-permit signal that AND-gates each joint's amp-enable-out in
# field_7i84u.hal. Use logic(9) as a 1-input NAND (= NOT):
#   personality 0x801 = 1 input + nand output (see logic(9) man page).
#   loadrt logic count=1 personality=0x801
#   'nand' with a single input equals the boolean inverse of that input.
# Reference: <https://linuxcnc.org/docs/html/man/man9/logic.9.html>
net watchdog-fault-any  => logic.watchdog-not.in-00
net watchdog-permit     <= logic.watchdog-not.nand

# Combined spindle permit. spindle-output-permit is the deliberate static
# commissioning hold initialized in field_7i84u.hal. It cannot by itself make
# an output live: current watchdog health, the software E-stop latch, and the
# FR-SX fault input, LinuxCNC machine-on state, and field servo-ready input must
# all permit motion in the same servo cycle. The hardwired E-stop chain remains
# the authoritative hazardous-power removal path.
net spindle-fault        => logic.spindle-fault-not.in-00
net spindle-fault-clear  <= logic.spindle-fault-not.nand
net spindle-output-permit => logic.spindle-permit-and.in-00
net watchdog-permit       => logic.spindle-permit-and.in-01
net estop-ok               => logic.spindle-permit-and.in-02
net spindle-fault-clear    => logic.spindle-permit-and.in-03
net machine-is-on          => logic.spindle-permit-and.in-04
net servo-ready            => logic.spindle-permit-and.in-05
net spindle-atc-ok         => logic.spindle-permit-and.in-06
net spindle-motion-permit  <= logic.spindle-permit-and.and

# ATC dry-run interlock (audit finding: a dry-run M6 spoofs the requested tool
# via M61 and returns success, so the interpreter believes a tool is loaded that
# was never physically changed). Two static bits, both default FALSE (safe),
# feed the spindle permit through spindle-atc-permit-or so the spindle runs only
# when spindle-atc-ok = (atc-live-permit OR spindle-maint-permit):
#
#   atc-live-permit    0 = ATC dry-run (default). The remap (M66 P15) takes its
#                      dry-run branch: spoof the tool with M61, assert no output,
#                      move no axis. 1 = real ATC cycles run.
#   spindle-maint-permit 0 = normal (default). 1 = spindle-live MAINTENANCE: the
#                      spindle is permitted while atc-live-permit stays 0, so the
#                      ATC is held idle. Lets you spin the spindle for diagnostics
#                      without arming real ATC motion. The remap (M66 P14) sees
#                      this and ABORTS any tool change instead of spoofing it, so
#                      the audit hazard (cutting with a spoofed tool) cannot recur
#                      while the spindle is live.
#
# Both are exposed on motion.digital-in-15 / -14 so the remap reads the SAME bits
# that enforce the permit here - interpreter and physical interlock cannot
# diverge. Release either only through a reviewed edit tied to a signed hold
# point, the same discipline as spindle-output-permit. Do NOT set both to 1: that
# is just "ATC live" with a redundant maintenance flag; clear maint before going
# fully live.
net atc-live-permit        => spindle-atc-permit-or.in0
net spindle-maint-permit   => spindle-atc-permit-or.in1
net spindle-atc-ok         <= spindle-atc-permit-or.out
net atc-live-permit        => motion.digital-in-15
net spindle-maint-permit   => motion.digital-in-14
sets atc-live-permit 0
sets spindle-maint-permit 0

# Fail-off axis commissioning hold. Leave FALSE until every drive ALM/ENA
# polarity, analog zero, resolver direction/scale, limit input, and hardwired
# E-stop drop test has passed. Clear this one hold only through a reviewed edit;
# do not bypass individual axis gates.
net watchdog-permit     => and2.6.in0
net drive-output-permit => and2.6.in1
sets drive-output-permit false
net motion-permit       <= and2.6.out

# estop-reset also feeds atc_orient.hal to clear its latched ATC / orient
# alarms in sync with the LinuxCNC re-enable. Additional readers pick up the
# same signal declared above.

# air-ok is assigned to 7i84U-B TB3 IN9 in field_7i84u.hal. An unwired or
# low input holds mazak-atc.air-ok FALSE and inhibits ATC actions. Verify the
# real pressure-switch contact polarity before enabling a live M6.

# Raw LinuxCNC spindle run request. field_7i84u.hal gates this and FWD/REV,
# while atc_orient.hal gates ORCM1, through spindle-motion-permit before any
# FR-SX motion-producing physical output or pwmgen enable can assert. That
# permit combines the static hold, watchdog, E-stop latch, and spindle fault.
# Orient/ATC reads the raw run-command state.
net spindle-enable-command <= spindle.0.on
