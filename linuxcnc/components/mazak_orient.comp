component mazak_orient "Mazak VQC 20/40 spindle gear-shift + orient state machine";

/*
 * mazak_orient.comp - LinuxCNC 2.9 realtime component
 *
 * Reproduces the Mazatrol M-2 (YM2V39L, drawing 4136081801) gear-shift and
 * spindle-orient sequence for the VQC 20/40 retrofit.
 *
 * AUTHORITATIVE SOURCE: docs/ladder/orient_ladder_transcription.md
 *   sheet 23 (power-up permissives), sheet 28 (range memories),
 *   sheet 29 (gear shift state machine), sheet 30 (orient proper),
 *   sheet 55 (orient/gear supervision).
 *
 * Behaviour summary (derived sequence, orient doc section "Derived sequence"):
 *   1. HYD.M pump permissive -> delayed drive arm (SSET.M equivalent).
 *   2. M19 / ATC prep sets the orient memory latch (SOME2); cancel conditions
 *      clear it (UOME2).
 *   3. Orient forces a gear-shift evaluation. A gear solenoid may only be
 *      energised AFTER a zero-speed dwell with no run command (T-5 -> ENGS).
 *   4. Orient command (ORCM1) is asserted only with a gear PRS confirmed and
 *      not mid-shift. orient-lo-gear (CTL.M) MIRRORS the low-gear solenoid.
 *   5. Arrival (ORA1) is debounced, then latched as the oriented latch (SOSA).
 *   6. Three watchdogs: orient timeout (AL45), oriented-while-rotating (AL46,
 *      hard fault - drops the drive arm and the orient command), oriented with
 *      no command (AL44, warning). Gear shift has its own watchdog (AL47).
 *      The external FR-SX fault input also drops the drive arm and the orient
 *      command; HAL separately aborts the ATC on that input. The gear
 *      solenoids are NOT dropped by the arm (B3, owner 2026-09-05): rungs
 *      2907/2910 carry no SSET/HYD contact, so the fork keeps hydraulic hold
 *      through a drive fault exactly as the OEM did.
 *
 * NOT MODELLED HERE (belongs in HAL/G-code, see linuxcnc/atc_orient.hal):
 *   - M38/M39 decode and the HSR/LSR range memories: the retrofit derives the
 *     target range from the commanded spindle speed, so gear-select-hi/lo are
 *     inputs here rather than internal M-code decodes (ladder rungs 2806-2809).
 *   - SFR/SRJ run commands (rungs 2801/2802) stay in the normal spindle HAL.
 *
 * SAFETY: every timer default below is UNVERIFIED. The M-2 timer base is not
 * known (see orient doc "Open questions" #1: T-5 K3, T-18 K100, T-19 K3000(?),
 * T-0 K201 - a 100 ms base gives 0.3 s / 10 s / 300 s / 20.1 s). The defaults
 * are safe engineering values, not transcribed machine values. Measure on the
 * live machine before trusting them. All are rw parameters so they can be
 * retuned with `setp` without rebuilding.
 */

description """
Gear-shift + spindle-orient sequencer for the Mazak VQC 20/40 retrofit
(Mesa 7i80HDT + 7i44 + 7i49 + two 7i84U remotes; P2 unused). Equivalent to Mazatrol M-2 ladder sheets 23/28/29/30/55.
Consumed by mazak_atc: the \\fBoriented-latch\\fR output is the SOSA bit that
gates tool unclamp and every ATC cycle step 1.
""";

license "GPL";
author "Mazak VQC 20/40 retrofit project";

option singleton yes;

//
// ---------------------------------------------------------------------------
// Machine permissives - sheet 23
// ---------------------------------------------------------------------------
//
pin in bit machine_ready = false
    "X118 MA.N - machine ready from the NC side (rung 2302).";
pin in bit servo_ready = false
    "X119 SA.N - servo ready (rung 2302). Net to servo-ready (7i84U IN31).";
pin in bit estop_ok = false
    "X000 ESP.M - E-stop chain healthy. TRUE = healthy (rung 2302).";
pin in bit drive_fault = false
    "FR-SX alarm input. TRUE drops drive-arm, gear commands, and ORCM1.  Net: spindle-fault (7i84U-A IN14; polarity must be field-verified).";

pin out bit hyd_pump_on
    "Y096 HYD.M - hydraulic + head-lube pump contactor (rung 2302).  Net: hyd-pump-on (7i84U-A TB3 OUT3, FACTORY_INTERFACE).";
pin out bit drive_arm
    "Y092 SSET.M - spindle drive arm/permissive (rung 2305). Held once made;  dropped by AL46, the external drive-fault input, or loss of the pump  permissive (instantly - the OEM gives a ~20 s T-0 grace). No Mesa pin assigned.";

//
// ---------------------------------------------------------------------------
// Orient request / cancel - sheet 30 rungs 3003 (SOME2) and 3008 (UOME2)
// ---------------------------------------------------------------------------
//
pin in bit orient_request = false
    "SOME2 set condition: M19 decode or recess step RCTSTEP2 (rung 3003). The  retrofit ALSO routes ATC orients here - the ladder's separate TCME path  (rung 3004, which bypasses SOME2/#GSFME/PRS) is deliberately not reproduced;  ATC orients run the strict path. Level or pulse - the component latches it.";
pin in bit orient_cancel = false
    "UOME2 set condition (rung 3008): gear M-code, ATC FIN pulse, jog,  program end, or spindle start. Clears the orient memory. NOTE: corrected  rung 3008 gates the gear/jog/program triggers with #TCME (no cancel  mid-ATC) and all triggers with #TOUCH.N*#DIHT.N; this comp does NOT  reproduce those gates - drive this pin only from the toolchange NGC.";
pin in bit fault_reset = false
    "RST / ALRST - rising edge clears the latched alarms AL44-AL47 and both  memories. A held input does not continuously erase new faults.";

//
// ---------------------------------------------------------------------------
// Spindle status inputs
// ---------------------------------------------------------------------------
//
pin in bit spindle_oriented = false
    "X003 ORA1 - FR-SX orient arrival. Net: spindle-oriented (7i84U IN4).";
pin in bit spindle_zero_speed = false
    "X001 SZS.M - FR-SX zero-speed. Net: spindle-zero-speed (7i84U IN5).";
pin in bit spindle_run = false
    "M78 SMR - spindle run memory (any FWD/REV command active). This comp  requires it FALSE for the zero-speed dwell - LADDER DISCREPANCY: rung 2905  draws SMR NO (OEM dwells with the run memory asserted); see the dwell  comment and audit bench check 28.";

//
// ---------------------------------------------------------------------------
// Gear range - sheets 28/29
// ---------------------------------------------------------------------------
//
pin in bit gear_select_hi = false
    "HSR (M83) target range = high. Derived from commanded spindle speed / M39.";
pin in bit gear_select_lo = false
    "LSR (M84) target range = low. Derived from commanded spindle speed / M38.  If neither or both are asserted the last valid target is held (default low).";
pin in bit gear_hi_conf = false
    "HGPRS / PRS-10 gear high confirm. Net: gear-hi-conf (7i84U IN17).";
pin in bit gear_lo_conf = false
    "LGPRS / PRS-12 gear low confirm. Net: gear-lo-conf (7i84U IN18).";

pin out bit gear_hi_sol
    "Y00B GSH.M gear-high solenoid (rung 2907). Net: gear-hi-sol (TB3 OUT7).  Sealed while high range is selected - the solenoid holds the shift fork.";
pin out bit gear_lo_sol
    "Y00C GSL.M gear-low solenoid (rung 2910). Net: gear-lo-sol (TB2 OUT8).  SOL-13 identity resolved 2026-08-08 (authority_conflicts sec 1 lineage);  field wire unlanded - fit RLY-2 + suppression before energising.";

//
// ---------------------------------------------------------------------------
// Orient outputs - sheet 30
// ---------------------------------------------------------------------------
//
pin out bit spindle_orient_cmd
    "Y093 ORCM1.M orient command to the FR-SX (rung 3004).  Net: spindle-orient-cmd (7i84U-A TB3 OUT4, FACTORY_INTERFACE).";
pin out bit orient_lo_gear
    "Y094 CTL.M low-gear orient (rung 3001). COMBINATIONAL MIRROR of  gear-lo-sol - not a sequenced step. Net: orient-lo-gear (TB3 OUT5).";
pin out bit oriented_latch
    "M92 SOSA spindle orient safety (rung 5509). THE bit the ATC consumes -  gate every ATC step and the tool unclamp on this, never on raw ORA1.";

//
// ---------------------------------------------------------------------------
// Status outputs
// ---------------------------------------------------------------------------
//
pin out bit orient_memory
    "M90 SOME2 orient memory latch (rung 3003).";
pin out bit gear_shifting
    "M86 GSFME / Y124 GSF.N - gear shift in progress (rungs 2902/2904).  Blocks the orient command.";
pin out bit gear_shift_enable
    "M88 ENGS (rung 2906) - zero-speed dwell satisfied, solenoids permitted.";
pin out bit gear_confirmed
    "Target range confirmed by its PRS. Diagnostic.";
pin out s32 state
    "0=IDLE 1=GEAR_EVAL 2=ZERO_SPEED_DWELL 3=SHIFTING 4=ORIENT_CMD  5=ORIENTED 6=FAULT.";

//
// ---------------------------------------------------------------------------
// Alarms - sheet 55. All latched until fault-reset.
// ---------------------------------------------------------------------------
//
pin out bit fault_orient_no_cmd
    "F44 AL44 orient malfunction 1 (rung 5506): oriented state present with no  orient command. WARNING only - does not drop anything.";
pin out bit fault_orient_timeout
    "F45 AL45 orient malfunction 2 (rung 5507): commanded, timed out, never  arrived. Drops the orient command.";
pin out bit fault_oriented_rotating
    "F46 AL46 orient malfunction 3 (rung 5508): oriented latch true while the  spindle is NOT at zero speed. HARD FAULT - drops drive-arm and ORCM1.";
pin out bit fault_gear_timeout
    "F47 AL47 (rung 5511): gear shift did not confirm. Blocks BOTH gear  solenoids until reset.";
pin out bit fault_any
    "Logical OR of the external drive fault and AL45/AL46/AL47.";

//
// ---------------------------------------------------------------------------
// Timers. EVERY DEFAULT IS UNVERIFIED - see the file header and the orient
// doc "Open questions" #1.
// ---------------------------------------------------------------------------
//
param rw float zero_speed_dwell = 0.3
    "T-5 (rung 2905), ladder K 3. Zero speed + no run command must persist this  long before a gear solenoid may be energised. UNVERIFIED (0.3 s assumes a  100 ms timer base).";
param rw float arrival_debounce = 0.3
    "ENGINEERING ADDITION - ORA1 debounce before the oriented latch sets. The  ladder's T-6 (rung 3006, K 3) feeds only the recess-tool logic (#4809);  rung 5509 latches SOSA from RAW ORA1. UNVERIFIED base.";
param rw float orient_timeout = 10.0
    "T-18 (rung 5504), ladder K 100. Orient commanded -> arrival watchdog  (AL45). UNVERIFIED (10 s assumes a 100 ms timer base).";
param rw float no_cmd_alarm_delay = 1.0
    "T-17 (rung 5503), ladder K 10. Oriented-with-no-command delay (AL44).  UNVERIFIED.";
param rw float gear_shift_timeout = 30.0
    "T-19 (rung 5510), ladder K 3000(?) - the transcription flags this K value  as ambiguous (300 s vs 30 s). 30 s is the doc's '30 s-class' engineering  value. UNVERIFIED - measure a real shift before trusting it.";
param rw float drive_arm_delay = 2.0
    "RETROFIT power-on arm delay - a deliberate conservatism, NOT a ladder  equivalence. The ladder's T-0 (rung 2304, K 201 ~ 20.1 s at a 100 ms base)  is a post-pump-stop grace (runs on #HYD.M * SZS.M) before SSET drops  (rung 2305, ESPT is NC - the OEM arms with no power-up delay). UNVERIFIED.";
param rw float zero_speed_debounce = 0.1
    "ENGINEERING ADDITION qualifying the AL46 test so a spin-up cannot trip it  on one scan. Ladder AL46 (rung 5508) uses #SZS.M directly, undebounced;  T-16/SZSK (rungs 5501/2, K 30) debounce the COMPUTED zero-speed status  (M132), not the sensor. UNVERIFIED.";

//
// Internal state.
//
variable int prev_hi_sol = 0;
variable int prev_lo_sol = 0;
variable int prev_orcm1 = 0;
variable int prev_sosa = 0;
variable int prev_fault_reset = 0;
variable int target_hi = 0;          // HSR/LSR range memory, low at power-up
variable int shift_pending = 0;
variable float t_dwell = 0.0;
variable float t_arrival = 0.0;
variable float t_orient_wd = 0.0;
variable float t_nocmd = 0.0;
variable float t_gear_wd = 0.0;
variable float t_arm = 0.0;
variable float t_zs_lost = 0.0;

function update "Run in the servo thread, after the hostmot2 read function.";

;;

/* Retriggerable on-delay: accumulate while cond, clear otherwise. */
#define TMR(acc, cond, limit)                                   \
    do {                                                        \
        if (cond) { if ((acc) < (limit)) (acc) += fperiod; }     \
        else { (acc) = 0.0; }                                   \
    } while (0)

#define ELAPSED(acc, limit) ((acc) >= (limit))

FUNCTION(update)
{
    int any_prs, tgt_conf, engs, mid_shift, hi, lo, arm_ok, orcm1, sosa;
    int cancel, reset_pulse;

    reset_pulse = fault_reset && !prev_fault_reset;
    prev_fault_reset = fault_reset;

    /* -----------------------------------------------------------------
     * Sheet 23 - permissives. Rung 2302: HYD.M = MA.N * SA.N * ESP.M.
     * ----------------------------------------------------------------- */
    hyd_pump_on = machine_ready && servo_ready && estop_ok;

    /* Rung 2305 (audit 2026-09-02): SSET.M = [(HYD.M || seal) * PW1.M * #ESPT
     * || DIHT.N || TOUCH.N] * #AL46. ESPT is NC - the OEM arms with NO
     * power-up delay; T-0 (K201) is a ~20 s post-pump-stop grace before the
     * arm drops. drive_arm_delay here is a deliberate retrofit conservatism,
     * not a ladder equivalence. */
    TMR(t_arm, hyd_pump_on, drive_arm_delay);
    arm_ok = hyd_pump_on && !fault_oriented_rotating && !drive_fault;
    if (!arm_ok) {
        drive_arm = false;
    } else if (ELAPSED(t_arm, drive_arm_delay) || drive_arm) {
        drive_arm = true;   /* seal */
    }

    /* -----------------------------------------------------------------
     * Fault reset. ALRST breaks every alarm seal (sheet 55).
     * ----------------------------------------------------------------- */
    if (reset_pulse) {
        fault_orient_no_cmd = false;
        fault_orient_timeout = false;
        fault_oriented_rotating = false;
        fault_gear_timeout = false;
        orient_memory = false;
        shift_pending = 0;
        t_orient_wd = 0.0;
        t_gear_wd = 0.0;
        t_nocmd = 0.0;
    }

    /* -----------------------------------------------------------------
     * Sheet 30 rungs 3003/3008 - orient memory SOME2 / unorient UOME2.
     * UOME2 dominates: any cancel condition clears the memory.
     * ----------------------------------------------------------------- */
    cancel = orient_cancel || reset_pulse || !drive_arm;
    /* rung 3003 SOME2 self-clear (decision-queue item 7, applied 2026-09-04):
     * the OEM's seal runs through #SOSA, so the memory clears itself once
     * arrival latches - it does not sit latched until a fresh cancel.
     * oriented_latch here still carries LAST scan's SOSA (this block runs
     * before SOSA/oriented_latch is recomputed later in this same function),
     * matching the ladder's own scan-order lag - rung 3003 reads rung 5509's
     * output from the previous scan too. Safe ONLY because orcm1 below no
     * longer ANDs orient_memory unconditionally - its own true seal (prev_orcm1)
     * is what now holds the orient command once SOME2 clears. */
    if (cancel || oriented_latch) {
        orient_memory = false;
    } else if (orient_request) {
        orient_memory = true;   /* set + seal */
    }

    /* -----------------------------------------------------------------
     * Sheets 28/29 - range memory and the gear shift state machine.
     *
     * Rungs 2808/2809: HSR and LSR are mutually exclusive sealed memories.
     * Here the target comes from the caller; hold the last valid selection
     * if the caller asserts both or neither.
     * ----------------------------------------------------------------- */
    if (gear_select_hi && !gear_select_lo) target_hi = 1;
    else if (gear_select_lo && !gear_select_hi) target_hi = 0;

    any_prs  = gear_hi_conf || gear_lo_conf;
    tgt_conf = target_hi ? gear_hi_conf : gear_lo_conf;
    gear_confirmed = tgt_conf ? true : false;

    /* Rung 2901 GSFTC: target range != confirmed position, OR the orient
     * memory is active (orient forces a gear-shift evaluation). The shift is
     * only actually required when the target PRS is not made.
     * FIX (decision-queue item 6, applied 2026-09-04): dropped the bare
     * "|| !any_prs" disjunct. Rung 2901 has exactly five OR branches -
     * (mismatch . GSFTC-seal), SOME2, M38CD, M39CD, SST - none test "neither
     * PRS confirmed". That term was the sole cause of shift_pending/mid_shift
     * latching SUSTAINED true at power-up whenever the fork sits mid-stroke
     * (both PRS unconfirmed, a normal transient, not a fault) with nothing
     * commanded - feeding the AL47 watchdog below into a 30s nuisance trip
     * with no shift ever requested. */
    if (!tgt_conf && (orient_memory || gear_select_hi || gear_select_lo)) {
        shift_pending = 1;
    } else if (tgt_conf) {
        shift_pending = 0;
    }

    /* Rung 2902 GSFME: latched while between confirmed positions. Reduces
     * algebraically to GSFTC && !tgt_conf given HSR/LSR are mutually
     * exclusive - the erroneous !any_prs here was the same defect duplicated
     * (item 6). any_prs itself stays correctly used below at orcm1 (rung
     * 3004's HGPRS/LGPRS term) - untouched by this fix. */
    mid_shift = shift_pending && !tgt_conf;
    gear_shifting = mid_shift ? true : false;

    /* Rungs 2905/2906 T-5 -> ENGS: solenoids only after the zero-speed dwell.
     * LADDER DISCREPANCY (audit 2026-09-02): rung 2905 draws SMR as a NO
     * contact - the OEM dwell runs with the run memory STILL ASSERTED (the
     * classic "jiggle the spindle into gear" pattern). This comp requires
     * !spindle_run instead; scope FWD + SZS during a commanded gear change
     * (bench check) before deciding whether to match the OEM and hold the
     * run output through the shift. Never energise a gear solenoid against
     * a turning spindle either way (spindle_zero_speed stays in the AND). */
    TMR(t_dwell, spindle_zero_speed && !spindle_run && mid_shift,
        zero_speed_dwell);
    engs = ELAPSED(t_dwell, zero_speed_dwell);
    gear_shift_enable = engs ? true : false;

    /* Rungs 2907/2910 (corrected topology applied 2026-09-04, decision-queue
     * item 5, owner-approved):
     *   GSH.M = [HSR || (HGPRS || seal-GSH) . #ENGS] . #GSL.M . #AL47
     *   GSL.M = [LSR || (LGPRS || seal-GSL) . #ENGS] . #GSH.M . #AL47
     * The COMMANDED range drives its own coil UNGATED (no dwell wait) - the
     * instant its target bit is set, that solenoid is asking to pick up.
     * The OUTGOING range's coil is instead held by its own PRS-or-seal term
     * ANDed with #ENGS, so it stays energised through the shift - fork
     * pressure never drops with the spindle still turning - until the
     * zero-speed dwell (ENGS) completes. The mutual `!prev_*_sol` interlock
     * is what actually sequences the handoff: the incoming coil cannot pick
     * up until the outgoing coil's hold term drops, even though its own
     * target term is already true. One servo-thread scan with both coils
     * off can occur right at the handoff - safe, matches the spring-center
     * valve's neutral position, not a race.
     * This also fixes D3c: a low-gear orient that needs no shift now holds
     * GSL.M (and so CTL/OUT5, rung 3001) continuously at rest, instead of
     * only during an active shift with the pre-audit gating below.
     *
     * B3 APPLIED 2026-09-05 (owner: "apply B3"): drive_arm is NO LONGER in
     * these equations. The corrected rungs carry no SSET/HYD contact, so the
     * pre-B3 `&& drive_arm` was an addition that made a drive fault (or AL46,
     * or the pump-stop grace) drop BOTH coils with the spindle possibly still
     * turning - the opposite of the OEM's hold. Now the coils reproduce the
     * rungs: the fork keeps its hydraulic hold through a fault, and the
     * only things that drop a coil are the handoff sequence itself and AL47
     * (fault_gear_timeout), matching the ladder. Consequences to know:
     *   - the default-low coil is energised from the first scan, before the
     *     pump/arm (harmless: no hydraulic pressure yet, same as OEM LSR);
     *   - state reads 3 (a coil held) instead of 0 whenever idle in a gear;
     *   - if hydraulics are lost the coil stays commanded; HYD.M dropping is
     *     what removes fork pressure, not the coil (also OEM behaviour).
     * Mechanical stop of the spindle is the drive's/E-stop's job, not the
     * gear valve's. */
    hi = ((target_hi) || ((gear_hi_conf || prev_hi_sol) && !engs))
         && !prev_lo_sol && !fault_gear_timeout;
    lo = ((!target_hi) || ((gear_lo_conf || prev_lo_sol) && !engs))
         && !prev_hi_sol && !fault_gear_timeout;
    if (hi && lo) { hi = 0; lo = 0; }   /* belt and braces - never both */
    gear_hi_sol = hi ? true : false;
    gear_lo_sol = lo ? true : false;
    prev_hi_sol = hi;
    prev_lo_sol = lo;

    /* Rung 3001: CTL.M = GSL.M. Combinational mirror, not a sequenced step. */
    orient_lo_gear = gear_lo_sol;

    /* Rungs 5510/5511 AL47 gear shift watchdog. The ladder qualifies T-19 with
     * #SOME2; here it runs on any pending shift so an orient-driven shift is
     * supervised too. Blocks both solenoids, latched until reset. */
    TMR(t_gear_wd, shift_pending && mid_shift && drive_arm, gear_shift_timeout);
    if (ELAPSED(t_gear_wd, gear_shift_timeout)) fault_gear_timeout = true;

    /* -----------------------------------------------------------------
     * Sheet 30 rung 3004 - ORCM1 (decision-queue item 7, applied 2026-09-04).
     * TRUE SEAL: once latched, a PRS/GSFME/SOME2 flicker of ANY duration
     * cannot drop OUT4 - the set-branch (orient_memory && any_prs &&
     * !mid_shift) is only evaluated for the FIRST pickup scan; the OR with
     * prev_orcm1 is the entire holding path from then on, same pattern as
     * gear_hi_sol/gear_lo_sol's own-PRS-or-seal branch above. Drops only on
     * AL45, AL46, a real cancel/unorient/reset, or drive-arm loss - matching
     * rung 3004's outer AND block. This seal is what makes SOME2's self-clear
     * (above) safe: ORCM1 no longer depends on orient_memory staying true. */
    orcm1 = ((orient_memory && any_prs && !mid_shift) || prev_orcm1)
            && !fault_orient_timeout
            && !fault_oriented_rotating
            && !cancel
            && drive_arm;
    spindle_orient_cmd = orcm1 ? true : false;
    prev_orcm1 = orcm1;

    /* Rung 5509 SOSA latch (OEM: RAW ORA1 - T-6/rung 3006 feeds only the recess
     * logic; this debounce is a retrofit engineering addition):
     * SOSA = ORA1 (debounced) OR (SOSA sealed while ORCM1 stands). */
    TMR(t_arrival, spindle_oriented, arrival_debounce);
    sosa = ELAPSED(t_arrival, arrival_debounce) || (prev_sosa && orcm1);
    if (fault_oriented_rotating || cancel) sosa = 0;
    oriented_latch = sosa ? true : false;
    prev_sosa = sosa;

    /* -----------------------------------------------------------------
     * Sheet 55 supervision.
     * ----------------------------------------------------------------- */

    /* AL45 (rung 5507): commanded, T-18 elapsed, never arrived.
     * OWNER BLESSED AS-IS 2026-09-05 (config-audit item 11a): AL45 only holds
     * off ORCM1 (via fault_orient_timeout in the orcm1 AND block); it does NOT
     * drop drive_arm. That split matches the ladder - only AL46 and the drive
     * fault take the arm down. Not an omission; do not "fix" it. */
    TMR(t_orient_wd, orcm1 && !sosa, orient_timeout);
    if (ELAPSED(t_orient_wd, orient_timeout)) fault_orient_timeout = true;

    /* AL46 (rung 5508): #SZS.M * SOSA. Hard fault. Debounced with T-16 so a
     * legitimate spin-up after unorient cannot trip it on a single scan. */
    TMR(t_zs_lost, sosa && !spindle_zero_speed, zero_speed_debounce);
    if (ELAPSED(t_zs_lost, zero_speed_debounce)) fault_oriented_rotating = true;

    /* AL44 (rung 5506): SOSA with T-17 (which runs while ORCM1 is absent).
     * Warning only. */
    TMR(t_nocmd, sosa && !orcm1, no_cmd_alarm_delay);
    if (ELAPSED(t_nocmd, no_cmd_alarm_delay)) fault_orient_no_cmd = true;

    fault_any = drive_fault || fault_orient_timeout || fault_oriented_rotating
                || fault_gear_timeout;

    /* -----------------------------------------------------------------
     * Diagnostic state.
     * ----------------------------------------------------------------- */
    if (fault_any)              state = 6;
    else if (sosa)              state = 5;
    else if (orcm1)             state = 4;
    else if (gear_hi_sol || gear_lo_sol) state = 3;
    else if (mid_shift && !engs) state = 2;
    else if (mid_shift)         state = 1;
    else                        state = 0;
}
