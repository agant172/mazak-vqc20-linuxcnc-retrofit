# OS / editor cruft
.DS_Store
Thumbs.db
*~
*.swp

# Python bytecode (io-dashboard/tools)
__pycache__/
*.pyc

# OneDrive placeholder / cache files
*.cloud
*.cloudf
desktop.ini

# NotebookLM / other HTML cache folders
*_cache/
*.nblm/

# Raw photo/video media — keep these in cloud storage, not in git.
# (photos/README.md is tracked; media files are ignored.)
*.jpg
*.jpeg
*.png
*.heic
*.heif
*.tif
*.tiff
*.mp4
*.mov
*.avi
*.mkv

# Obsidian vault state.
# The repo doubles as an Obsidian vault, so .obsidian/ is tracked on purpose —
# that is how appearance, hotkeys, and enabled plugins follow you between the
# MacBook Pro, the iMac, and the OptiPlex. Only per-machine state and anything
# that can hold a credential is excluded:
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/.trash/
# Plugin *code* is not tracked — the bundles run to ~9 MB of vendored JS and
# would drown every PR diff. community-plugins.json below records which plugins
# are enabled; install them once per machine from Obsidian's community store.
.obsidian/plugins/
# (Belt and braces: plugin settings can contain API keys — obsidian-local-rest-api
# stores one. The repo went private 2026-08-16, which does not help: a committed
# secret stays in history and comes back if it is ever public again. Never track
# a plugin data.json.)
.obsidian/plugins/*/data.json

# LinuxCNC / Mesa runtime outputs kept locally, not committed
mesa_readhmid.txt
mesa_hal_pins.txt
linuxcnc.var.bak
*.var.bak

# Shareable single-file build of the I/O Navigator (tools/build_standalone.py).
# Derived from index.html + the CSS/JS in this folder — rebuild it, never commit it.
io-dashboard/dist/
